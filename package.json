{
  "name": "stockradar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "ingest": "tsx --conditions=react-server --env-file=.env.local scripts/ingest.ts",
    "scores": "tsx --conditions=react-server --env-file=.env.local scripts/calculate-scores.ts"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.3.6",
    "@google/genai": "latest",
    "drizzle-orm": "latest",
    "postgres": "^3.4.7",
    "lucide-react": "latest",
    "recharts": "latest",
    "server-only": "^0.0.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0",
    "class-variance-authority": "^0.7.1",
    "@radix-ui/react-slot": "latest"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.2.0",
    "@tailwindcss/postcss": "^4.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "vitest": "latest",
    "@testing-library/react": "latest",
    "@testing-library/jest-dom": "latest",
    "jsdom": "latest",
    "@playwright/test": "latest",
    "drizzle-kit": "latest",
    "tsx": "latest"
  },
  "type": "module"
}
